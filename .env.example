# ATRA configuration.
#
# Copy to .env and edit. Every value here is optional: ATRA boots with an empty
# file and you finish configuring it from the dashboard.
#
# ┌──────────────────────────────────────────────────────────────────────────┐
# │ This file never contains a private key, a seed phrase or a wallet        │
# │ password. Wallet secrets are generated on your machine, encrypted with   │
# │ your dashboard password and stored in the data directory. ATRA has no    │
# │ way to read them and no server to send them to.                         │
# └──────────────────────────────────────────────────────────────────────────┘

# --- server ----------------------------------------------------------------

# Loopback only by default. Inside Docker this is set to 0.0.0.0 and the port is
# published to 127.0.0.1 by compose, which has the same effect.
ATRA_HOST=127.0.0.1
ATRA_PORT=3000

# Where the encrypted vault, the database and backups live. Back this up.
# ATRA_DATA_DIR=./data

# Extra hostnames ATRA will answer to, comma separated. Loopback names are
# always accepted. Only add one if you front ATRA with a reverse proxy.
# ATRA_HOST_ALLOWLIST=atra.home.lan

# Browser origins allowed to call the API. Leave empty for same-origin only;
# set it to the Vite dev server when working on the dashboard.
# ATRA_CORS_ORIGINS=http://127.0.0.1:5173

# Minutes of inactivity before the wallet vault locks itself and the password
# is needed again.
ATRA_AUTOLOCK_MINUTES=30

# --- logging ---------------------------------------------------------------

# fatal | error | warn | info | debug | trace | silent
ATRA_LOG_LEVEL=info
# Human-readable output. Set to 0 for JSON lines in production.
ATRA_LOG_PRETTY=1

# --- mode ------------------------------------------------------------------

# normal | ci
#
# "ci" boots with no providers, no scheduler and no model, so a container smoke
# test can reach /health without any credential. Never use it for real trading.
ATRA_MODE=normal

# --- RPC endpoints (optional) ----------------------------------------------
#
# ATRA ships with keyless public endpoints for all four chains, which are rate
# limited and fine for getting started. Supply your own for reliability. A URL
# containing an API key is a secret: keep this file out of version control.
#
# ATRA_RPC_BASE=https://mainnet.base.org
# ATRA_RPC_BSC=https://bsc-dataseed.bnbchain.org
# ATRA_RPC_ROBINHOOD=https://rpc.mainnet.chain.robinhood.com
# ATRA_RPC_SOLANA=https://api.mainnet-beta.solana.com

# --- reasoning model (optional) --------------------------------------------
#
# none             no model; the agent reports INSUFFICIENT_DATA and does nothing
# ollama           a local Ollama server (default: http://127.0.0.1:11434)
# openai-compatible  any endpoint speaking the OpenAI chat completions API
#
# The model proposes; it never signs, never broadcasts and cannot override a
# risk rejection.
# ATRA_LLM_KIND=ollama
# ATRA_LLM_URL=http://127.0.0.1:11434
# ATRA_LLM_MODEL=atra-4b

# Name of the environment variable that holds the API key, not the key itself.
# ATRA_LLM_API_KEY_ENV=MY_PROVIDER_KEY
